# Пример .env. Скопируй в .env и подставь свои значения.
# .env НЕ коммитится в git (см. .gitignore) — там живут секреты.

# --- База и WhatsApp ---
# В Docker пароль передаётся отдельно от URL; кириллица тоже поддерживается.
# Для существующей базы меняй его также через psql: \password financebot.
POSTGRES_PASSWORD=change-me
TZ=Europe/Moscow
WHATSAPP_GROUP_JIDS=

# --- GPT через ODIRouter ---
# Вставь существующий ключ ODIRouter. Старое имя OPENROUTER_API_KEY тоже работает.
ODIROUTER_API_KEY=
OPENROUTER_BASE_URL=https://api.odirouter.ai/v1
OPENROUTER_MODEL=gpt-6.1-sol
OPENROUTER_VISION_MODEL=gpt-6.1-sol
OPENROUTER_API_MODE=responses
OPENROUTER_REASONING_EFFORT=medium
OPENROUTER_EXTRACT_REASONING_EFFORT=low
# Лимит включает рассуждения GPT и видимый ответ.
OPENROUTER_MAX_TOKENS=8192
OPENROUTER_VISION_MAX_TOKENS=4096
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_VISION_FALLBACK_MODELS=
BOT_NAME=Джарвис
OWNER_NUMBERS=
REPORT_ADMINS=89287836800,89899171578

# --- Программа рассрочек (сверка) ---
CMF_API_URL=
CMF_EMAIL=
CMF_PASSWORD=

# Окно спаривания чек↔имя клиента по времени сообщения (минуты). Имя, присланное
# ПЕРЕД/ПОСЛЕ чека, привязывается к нему в пределах этого окна. Явный свайп-ответ
# на чек работает и вне окна. По умолчанию 15.
RECEIPT_PAIR_WINDOW_MINUTES=15

# Если в момент прихода чека модель зрения была недоступна, бот перечитывает чек
# в фоне, когда ИИ вернётся. Сколько раз пытаться, прежде чем оставить на ручную
# проверку (по умолчанию 6).
RECEIPT_RETRY_MAX=6

# Разовое восстановление истории из WhatsApp (после потери сервера). 0 = выкл.
# Включи =1 только на время импорта, перепривяжи бота (новый QR) — он молча
# разберёт присланную историю в чеки; потом верни 0. Вернёт лишь недавнее окно.
IMPORT_HISTORY=0

# --- СЕКРЕТНЫЙ файл (например «доступы к проектам») ---
# Бот отдаёт файл ТОЛЬКО в личке, ТОЛЬКО этим номерам, по коду и после «да».
# 1) Положи PDF в папку ./secret/ (она в .gitignore, в git не попадёт).
# 2) Задай код НИЖЕ. Пустой код => функция выключена.
SECRET_FILE_PATH=/app/secret/dostupy.pdf
SECRET_FILE_NAME=Доступы к проектам.pdf
SECRET_FILE_RECIPIENTS=89287836800,89899171578,89280032462
SECRET_FILE_CODE=
